<?xml version="1.0" standalone="no"?>
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">AQENO on %h</name>
  <service>
    <type>_http._tcp</type>
    <port>8766</port>
    <txt-record>path=/api/docs</txt-record>
    <txt-record>product=AQENO</txt-record>
    <txt-record>api=v1</txt-record>
  </service>
</service-group>
