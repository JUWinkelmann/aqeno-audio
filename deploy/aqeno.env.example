AQENO_APPLIANCE=1
AQENO_DATA_ROOT=/aqeno-data
AQENO_APPLICATION_ROOT=/opt/aqeno/current
AQENO_ADMIN_DIR=/opt/aqeno/current/admin
QT_QPA_PLATFORM=eglfs
QT_QPA_EGLFS_HIDECURSOR=1
# Stable ALSA card ID from the RH1 hifiberry-dac overlay; never a numeric hw: index.
AQENO_ALSA_DEVICE=plughw:CARD=sndrpihifiberry,DEV=0
# Enabled by install-boot-presentation.sh only after canonical artwork and the real RH1
# Device UI/display path have passed the hardware handover test.
# AQENO_BOOT_PRESENTATION=plymouth
